# Template for `.env`. Copy to `.env` and fill in. `.env` is gitignored; `bin/run` sources it
# before each command (variables already exported in the shell win over `.env`).
#
# Since EXP002 everything runs locally on one H200 studio (Lightning): no TPU, no GCS. The
# EXP001 laptop/TPU variables live in git history (gcp/ scripts are kept as the record).

# --- Device ---
DEVICE=cuda                             # cuda | cpu (blank = auto)

# --- Caches (persistent studio disk) ---
HF_HOME=$HOME/.cache/huggingface        # Lightning presets the same value in the shell
UV_CACHE_DIR=$HOME/.cache/uv
NLA_MODEL_STORE=/teamspace/uploads/nla-metrics/hf   # Teamspace-drive copies (<org>--<name>/), fallback when the Hub fails

# --- Outputs (local) ---
SCRATCH=$HOME/scratch
ARTIFACT_DIR=./artifacts                # per-experiment stage outputs (gitignored); use an absolute path when running from elsewhere
LOG_DIR=${SCRATCH}/logs                 # detached-run logs (bin/launch_bg.sh)

# --- Models (all ungated on the HF Hub) ---
# EXP002: the community 27B NLA
TARGET_MODEL=Qwen/Qwen3.6-27B
NLA_REPO=ceselder/qwen3.6-27b-nla-rl
NLA_AV_ADAPTER=iter_000300              # av_rl_adapters/<this> on top of av_base
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
# EXP001 (retired TPU line; experiments/001_*.py still read these)
NLA_AV=kitft/nla-qwen2.5-7b-L20-av
NLA_AR=kitft/nla-qwen2.5-7b-L20-ar

# --- W&B ---
WANDB_MODE=disabled                     # W&B skipped for this project (user decision 2026-09-03)
