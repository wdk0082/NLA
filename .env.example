# Template for `.env`. Copy to `.env` and fill in. `.env` is gitignored.
# `bin/run` sources this before each command.
#
# The SAME repo runs in two places — your laptop (orchestration / analysis)
# and the TPU VM (compute) — each with its own `.env`. Keys tagged [VM]
# matter on the TPU, [local] on your laptop, untagged on both.
# `gcp/bootstrap.sh` writes a VM-appropriate `.env` at provision time.

# --- Identity ---
CRSID=zx332

# --- gcloud accounts (two accounts on this laptop) --- [local]
GCLOUD_ACCOUNT=                      # [local] account that may drive the TPU project
GCS_ACCOUNT=                         # [local] account that owns the bucket project

# --- TPU (course-managed project — COMPUTE ONLY, no durable storage here) ---
PROJECT_ID=dis-2026-tpu-${CRSID}
ZONE=us-east5-b
ACCELERATOR_TYPE=v6e-1
RUNTIME_VERSION=v2-alpha-tpuv6e
TPU_NAME=dis-2026-${CRSID}-tpu        # ADOPTED long-lived on-demand node: gcp/start.sh / gcp/stop.sh
QR_NAME=dis-2026-${CRSID}-qr          # only used by create.sh/teardown.sh (not for the adopted node)
TPU_SPOT=0                            # 1 = Spot (cheap, preemptible); 0 = on-demand

# --- Durable storage (YOUR project + billing; survives TPU deletion) ---
GCS_PROJECT=myloop-2026
GCS_BUCKET=dis-2026-zx332-tpu-store   # leave EMPTY to use local-pull mode (no bucket)
GCS_PREFIX=nla-metrics                # this project's namespace in the bucket (old exp_001/exp_002 live at the root)
# Cross-project auth for the TPU -> bucket: keyless (default compute SA has objectAdmin; done 2026-08-29).
# GOOGLE_APPLICATION_CREDENTIALS=$HOME/.gcp/sa-key.json   # [VM] key fallback, unused

# --- Code sync to the VM ---
GIT_REMOTE=                           # e.g. git@github.com:<user>/<repo>.git
GIT_REF=main
GIT_DEPLOY_KEY=gcp/keys/deploy_key    # read-only deploy key (private repo); scp'd to the VM by bootstrap.sh

# --- Device ---
DEVICE=                               # [VM] tpu  |  [local] cpu or blank (auto)

# --- On-VM ephemeral scratch (caches + staging; LOST on TPU delete) --- [VM]
# NOTE: bootstrap.sh mounts a tmpfs at /mnt/ramdisk (80G) and appends VM overrides
# HF_HOME=/mnt/ramdisk/hf, UV_CACHE_DIR=/mnt/ramdisk/uv-cache (the boot disk is nearly full
# with the previous line's caches; RAM is lost on stop -> ~1 min re-download). Override with
# VM_RAMDISK / VM_HF_HOME / VM_UV_CACHE_DIR when running bootstrap.sh.
SCRATCH=$HOME/scratch
HF_HOME=${SCRATCH}/hf
UV_CACHE_DIR=${SCRATCH}/uv-cache
ARTIFACT_DIR=${SCRATCH}/nla-metrics/artifacts   # local staging (own dir: ~/scratch/artifacts holds the previous line); synced -> GCS
LOG_DIR=${SCRATCH}/logs               # detached-run logs (gcp/launch_bg.sh)

# --- Durable output locations (GCS) ---
CKPT_DIR=gs://${GCS_BUCKET}/${GCS_PREFIX}/checkpoints
GCS_ARTIFACTS=gs://${GCS_BUCKET}/${GCS_PREFIX}/artifacts

# --- Local pull destination --- [local]
LOCAL_ARTIFACTS=./artifacts

# --- Models (all ungated on the HF Hub) ---
TARGET_MODEL=Qwen/Qwen2.5-7B-Instruct
NLA_AV=kitft/nla-qwen2.5-7b-L20-av
NLA_AR=kitft/nla-qwen2.5-7b-L20-ar
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# --- Secrets / W&B ---
# HF_TOKEN=                           # not needed: every model/dataset used is ungated
WANDB_MODE=disabled                   # W&B skipped for this project (user decision 2026-09-03)
# WANDB_API_KEY=
# WANDB_ENTITY=wdk0082
# WANDB_PROJECT=nla
